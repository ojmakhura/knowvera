# Copy to .env and fill in. The Makefile sources .env for the local runs, tests and image builds of
# knowvera-api and veritas-processor; docker-compose.yml reads the same names.

# --- knowvera-api ---
export PORT=8085
export DATABASE_URL=jdbc:postgresql://host/knowvera
export DB_USERNAME=username
export DB_PASSWORD=password
export DB_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
export DRIVER_CLASS=org.postgresql.Driver
export SHOW_SQL=false
export RATE_LIMIT=30
export ORGANISATION_MANAGER_ROLE=ORG_ADMIN
export MIN_PASSWORD_LENGTH=12
export ADMIN_WEB_URL=http://localhost:4200
export REGISTRATION_URL=http://localhost:4300/register
export OTLP_URL=http://otel-collector:4317
# Years a closed relationship is kept (Financial Intelligence Act s.32)
export RECORD_RETENTION_YEARS=20

# --- Keycloak (shared) ---
export AUTH_URL=http://keycloak
export REALM=knowvera
export CLIENT_ID=knowvera-api
# knowvera-api's own client: resource-based authorization, and its calls to veritas-processor
export API_CLIENT=knowvera-api
export API_CLIENT_SECRET=secret

# --- Redis ---
export REDIS_HOST=redis
export REDIS_PORT=6379
export REDIS_TIMEOUT=2000
export REDIS_PASSWORD=redispassword

# --- RabbitMQ (shared: knowvera-api queues, and the veritas-processor jobs and results) ---
export RABBITMQ_HOST=localhost
export RABBITMQ_PORT=5672
export RABBITMQ_USERNAME=username
export RABBITMQ_PASSWORD=password

# --- Document storage (shared): external S3-compatible server (Garage, SeaweedFS); see docs/storage.md ---
export S3_ENDPOINT=https://s3.example.com
export S3_REGION=garage
export S3_ACCESS_KEY=
export S3_SECRET_KEY=
export S3_BUCKET=knowvera
export S3_CREATE_BUCKET=false
# docker-compose only: a read-only key for veritas-processor (blank: the key above)
export VERITAS_S3_ACCESS_KEY=
export VERITAS_S3_SECRET_KEY=

# --- Notifications ---
export COMM_SERVICE_URL=http://
export SEND_MESSAGE_URL=${COMM_SERVICE_URL}/message/send
export SOURCE_EMAIL=kyc@roguesystems.co.bw
export NOVU_API_KEY=
export NOVU_BASE_URL=https://novu
export NOVU_NEW_USER_NOVU_ID=new-user
export NOVU_NEW_ORG_USER_NOVU_ID=new-organisation-user
export NOVU_NEW_ORG_CLIENT_REQUEST_NOVU_ID=kyc-request
export NOVU_NEW_KYC_RECORD_NOVU_ID=new-kyc-record

# --- knowvera-api -> veritas-processor ---
export VERITAS_URL=http://localhost:8086
# The profile of document types that name none
export PROCESSING_DEFAULT_PROFILE=default
# Migration from the in-process pipeline: start knowvera-api once with true (see veritas-processor/README.md)
export VERITAS_SEED_PROFILES=false
# What the removed pipeline's LM_STUDIO tool meant, for the seeding: ollama or lmstudio
export LLM_ID=ollama

# --- veritas-processor ---
export VERITAS_PORT=8086
# Its own database (profiles and job history)
export VERITAS_DATABASE_URL=jdbc:postgresql://host/veritas
export VERITAS_DB_USERNAME=veritas
export VERITAS_DB_PASSWORD=password
# Keep documents in the deployment: never send them to Gemini
export PROCESSING_LOCAL_ONLY=false
# Text extraction: Tesseract (the image sets its own path) and its limits
export TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
export TESSDATA_LANGS=eng
export VERITAS_MAX_FILE_SIZE=25MB
export VERITAS_MAX_PAGES=50
# Local models; LLM_MODEL is used when a step names no model
export OLLAMA_BASE_URL=http://localhost:11434
export LMSTUDIO_BASE_URL=http://localhost:1234
export LLM_MODEL=gemma4
# Ollama's context window in tokens: a prompt that does not fit fails instead of being cut short
export OLLAMA_NUM_CTX=8192
export LLM_READ_TIMEOUT=5m
# Gemini on Vertex AI (Google Cloud application default credentials)
export GEMINI_PROJECT_ID=central-kyc
export GEMINI_LOCATION=us-central1
# Jobs: consumers (min-max), tries of a step whose providers were unreachable, and when a job
# that is still running counts as interrupted
export VERITAS_JOB_CONCURRENCY=1-4
export VERITAS_JOB_ATTEMPTS=3
export VERITAS_JOB_STALE_AFTER=2h
# How long the job history (document text and fields included) is kept, e.g. 90d; blank: forever
export VERITAS_JOB_RETENTION=
# The API documentation (Swagger) needs no sign-in
export VERITAS_API_DOCS=true

# --- Images (make build_*_image) ---
export API_IMAGE_NAME=ojmakhura/knowvera-api
export VERITAS_IMAGE_NAME=ojmakhura/veritas-processor
export PORTAL_IMAGE_NAME=ojmakhura/knowvera-portal
export ADMIN_IMAGE_NAME=ojmakhura/knowvera-admin-portal
