{
  "name": "portal",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "generate": "ng generate",
    "test": "ng test",
    "prepare": "husky",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,json}\"",
    "docs": "hads -o -p 4040",
    "docs:build": "hads -o -p 4040"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.5.1",
  "dependencies": {
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/material": "^22.1.4",
    "@angular/material-moment-adapter": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/platform-server": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@angular/ssr": "^22.1.4",
    "@ngrx/operators": "^22.0.0",
    "@ngrx/signals": "^22.0.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "express": "^5.2.1",
    "keycloak-angular": "^22.0.0",
    "keycloak-js": "^26.2.2",
    "ngx-mat-select-search": "^8.0.4",
    "ngx-quill": "^31.0.0",
    "ngx-sonner": "^3.1.0",
    "ngx-spinner": "^22.0.0",
    "quill": "^2.0.3",
    "@novu/js": "^3.17.0",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.26.17",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "hads": "^3.0.3",
    "husky": "^9.1.7",
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.26",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
