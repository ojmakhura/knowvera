<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="
                        http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!--
        Document processing, merged in from the former veritas-processor service.
        Hibernate (ddl-auto: update) normally makes these tables and columns before this runs, so the
        change sets that create them are marked as run; they make the schema on a database Hibernate
        has not touched. The data of the former service is copied by ProcessingDataMigration.
    -->
    <changeSet id="processing-1-profiles" author="ojmakhura">
        <!-- Hibernate may have made this already (ddl-auto: update) -->
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="processing_profile"/></not></preConditions>
        <createTable tableName="processing_profile">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="code" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="version" type="INT"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="description" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="created_by" type="VARCHAR(255)"/>
        </createTable>
        <addUniqueConstraint tableName="processing_profile" columnNames="code, version" constraintName="uk_processing_profile_code_version"/>

        <createTable tableName="processing_profile_step">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="profile_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_processing_step_profile" referencedTableName="processing_profile" referencedColumnNames="id"/>
            </column>
            <column name="position" type="INT"><constraints nullable="false"/></column>
            <column name="step_type" type="VARCHAR(40)"><constraints nullable="false"/></column>
            <column name="model" type="VARCHAR(255)"/>
            <column name="system_prompt" type="TEXT"/>
            <column name="user_prompt" type="TEXT"/>
        </createTable>

        <createTable tableName="processing_profile_step_provider">
            <column name="step_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_processing_provider_step" referencedTableName="processing_profile_step" referencedColumnNames="id"/>
            </column>
            <column name="position" type="INT"><constraints nullable="false"/></column>
            <column name="provider" type="VARCHAR(40)"><constraints nullable="false"/></column>
        </createTable>
        <addPrimaryKey tableName="processing_profile_step_provider" columnNames="step_id, position"/>

        <createTable tableName="processing_profile_step_option">
            <column name="step_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_processing_option_step" referencedTableName="processing_profile_step" referencedColumnNames="id"/>
            </column>
            <column name="option_key" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="option_value" type="VARCHAR(1000)"/>
        </createTable>
        <addPrimaryKey tableName="processing_profile_step_option" columnNames="step_id, option_key"/>
    </changeSet>

    <changeSet id="processing-1-jobs" author="ojmakhura">
        <!-- Hibernate may have made this already (ddl-auto: update) -->
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="processing_job"/></not></preConditions>
        <createTable tableName="processing_job">
            <column name="id" type="VARCHAR(64)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="correlation_id" type="VARCHAR(255)"/>
            <column name="profile_code" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="profile_version" type="INT"/>
            <column name="status" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="started_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="finished_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="request_json" type="TEXT"/>
            <column name="result_text" type="TEXT"/>
            <column name="fields_json" type="TEXT"/>
            <column name="classification_json" type="TEXT"/>
            <column name="error" type="TEXT"/>
        </createTable>
        <createIndex tableName="processing_job" indexName="ix_processing_job_correlation">
            <column name="correlation_id"/>
        </createIndex>

        <createTable tableName="processing_job_step">
            <column name="job_id" type="VARCHAR(64)">
                <constraints nullable="false" foreignKeyName="fk_processing_job_step_job" referencedTableName="processing_job" referencedColumnNames="id"/>
            </column>
            <column name="position" type="INT"><constraints nullable="false"/></column>
            <column name="step_type" type="VARCHAR(40)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="provider" type="VARCHAR(40)"/>
            <column name="model" type="VARCHAR(255)"/>
            <column name="duration_ms" type="BIGINT"><constraints nullable="false"/></column>
            <column name="failures" type="TEXT"/>
        </createTable>
        <addPrimaryKey tableName="processing_job_step" columnNames="job_id, position"/>
    </changeSet>

    <changeSet id="processing-2-job-owner-and-age" author="ojmakhura">
        <!-- Hibernate may have made this already (ddl-auto: update) -->
        <preConditions onFail="MARK_RAN"><not><columnExists tableName="processing_job" columnName="submitted_by"/></not></preConditions>
        <!-- Who submitted a job through the API (null: from the queue); only they read it -->
        <addColumn tableName="processing_job">
            <column name="submitted_by" type="VARCHAR(255)"/>
        </addColumn>
        <!-- The stale job sweep and the retention purge look jobs up by age -->
        <createIndex tableName="processing_job" indexName="ix_processing_job_started_at">
            <column name="started_at"/>
        </createIndex>
    </changeSet>


    <!-- Expected fields hold their definitions again (they were kept in veritas-processor for a while).
         FIELD_TYPE may still be NOT NULL from before: it is optional now, STRING when empty. -->
    <changeSet id="processing-3-expected-field-definitions" author="knowvera">
        <preConditions onFail="MARK_RAN"><not><columnExists tableName="expected_field" columnName="field_label"/></not></preConditions>
        <addColumn tableName="expected_field">
            <column name="field_label" type="VARCHAR(255)"/>
            <column name="field_type" type="VARCHAR(255)"/>
            <column name="format" type="VARCHAR(255)"/>
            <column name="many" type="BOOLEAN"/>
            <column name="mandatory" type="BOOLEAN"/>
        </addColumn>
    </changeSet>
    <changeSet id="processing-4-expected-field-type-optional" author="knowvera">
        <preConditions onFail="MARK_RAN"><columnExists tableName="expected_field" columnName="field_type"/></preConditions>
        <dropNotNullConstraint tableName="expected_field" columnName="field_type" columnDataType="VARCHAR(255)"/>
        <sql>UPDATE expected_field SET field_type = 'STRING' WHERE field_type IS NULL</sql>
    </changeSet>

    <!-- A document type's own prompts (they were a data processor's in veritas-processor) -->
    <changeSet id="processing-5-document-type-prompts" author="knowvera">
        <preConditions onFail="MARK_RAN"><not><columnExists tableName="document_type" columnName="validation_prompts"/></not></preConditions>
        <addColumn tableName="document_type">
            <column name="validation_prompts" type="JSONB"/>
            <column name="text_extraction_prompts" type="JSONB"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
