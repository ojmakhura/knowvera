<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="
                        http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="veritas-1-profiles" author="ojmakhura">
        <!-- Hibernate may have made this already (ddl-auto: update) -->
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="veritas_profile"/></not></preConditions>
        <createTable tableName="veritas_profile">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="code" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="version" type="INT"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="description" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="created_by" type="VARCHAR(255)"/>
        </createTable>
        <addUniqueConstraint tableName="veritas_profile" columnNames="code, version" constraintName="uk_veritas_profile_code_version"/>

        <createTable tableName="veritas_profile_step">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="profile_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_veritas_step_profile" referencedTableName="veritas_profile" referencedColumnNames="id"/>
            </column>
            <column name="position" type="INT"><constraints nullable="false"/></column>
            <column name="step_type" type="VARCHAR(40)"><constraints nullable="false"/></column>
            <column name="model" type="VARCHAR(255)"/>
            <column name="system_prompt" type="TEXT"/>
            <column name="user_prompt" type="TEXT"/>
        </createTable>

        <createTable tableName="veritas_profile_step_provider">
            <column name="step_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_veritas_provider_step" referencedTableName="veritas_profile_step" referencedColumnNames="id"/>
            </column>
            <column name="position" type="INT"><constraints nullable="false"/></column>
            <column name="provider" type="VARCHAR(40)"><constraints nullable="false"/></column>
        </createTable>
        <addPrimaryKey tableName="veritas_profile_step_provider" columnNames="step_id, position"/>

        <createTable tableName="veritas_profile_step_option">
            <column name="step_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_veritas_option_step" referencedTableName="veritas_profile_step" referencedColumnNames="id"/>
            </column>
            <column name="option_key" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="option_value" type="VARCHAR(1000)"/>
        </createTable>
        <addPrimaryKey tableName="veritas_profile_step_option" columnNames="step_id, option_key"/>
    </changeSet>

    <changeSet id="veritas-1-jobs" author="ojmakhura">
        <!-- Hibernate may have made this already (ddl-auto: update) -->
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="veritas_job"/></not></preConditions>
        <createTable tableName="veritas_job">
            <column name="id" type="VARCHAR(64)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="correlation_id" type="VARCHAR(255)"/>
            <column name="profile_code" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="profile_version" type="INT"/>
            <column name="status" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="started_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="finished_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="request_json" type="TEXT"/>
            <column name="result_text" type="TEXT"/>
            <column name="fields_json" type="TEXT"/>
            <column name="classification_json" type="TEXT"/>
            <column name="error" type="TEXT"/>
        </createTable>
        <createIndex tableName="veritas_job" indexName="ix_veritas_job_correlation">
            <column name="correlation_id"/>
        </createIndex>

        <createTable tableName="veritas_job_step">
            <column name="job_id" type="VARCHAR(64)">
                <constraints nullable="false" foreignKeyName="fk_veritas_job_step_job" referencedTableName="veritas_job" referencedColumnNames="id"/>
            </column>
            <column name="position" type="INT"><constraints nullable="false"/></column>
            <column name="step_type" type="VARCHAR(40)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="provider" type="VARCHAR(40)"/>
            <column name="model" type="VARCHAR(255)"/>
            <column name="duration_ms" type="BIGINT"><constraints nullable="false"/></column>
            <column name="failures" type="TEXT"/>
        </createTable>
        <addPrimaryKey tableName="veritas_job_step" columnNames="job_id, position"/>
    </changeSet>

    <changeSet id="veritas-2-job-owner-and-age" author="ojmakhura">
        <!-- Hibernate may have made this already (ddl-auto: update) -->
        <preConditions onFail="MARK_RAN"><not><columnExists tableName="veritas_job" columnName="submitted_by"/></not></preConditions>
        <!-- Who submitted a job through the API (null: from the queue); only they read it -->
        <addColumn tableName="veritas_job">
            <column name="submitted_by" type="VARCHAR(255)"/>
        </addColumn>
        <!-- The stale job sweep and the retention purge look jobs up by age -->
        <createIndex tableName="veritas_job" indexName="ix_veritas_job_started_at">
            <column name="started_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="veritas-3-processors" author="ojmakhura">
        <!-- Hibernate may have made this already (ddl-auto: update) -->
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="data_processor"/></not></preConditions>
        <!-- Data processors: what is to be done with a kind of data, the fields expected in it,
             what they are verified against and how they are grouped -->
        <createTable tableName="data_processor">
            <column name="id" type="UUID"><constraints nullable="false" primaryKey="true" primaryKeyName="data_processor_pkey"/></column>
            <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="created_by" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="modified_at" type="TIMESTAMP"/>
            <column name="modified_by" type="VARCHAR(255)"/>
            <column name="code" type="VARCHAR(255)"><constraints nullable="false" unique="true" uniqueConstraintName="uk_data_processor_code"/></column>
            <column name="name" type="VARCHAR(255)"><constraints nullable="false" unique="true" uniqueConstraintName="uk_data_processor_name"/></column>
            <column name="description" type="VARCHAR(255)"/>
            <column name="expires" type="BOOLEAN"/>
            <column name="validation_prompts" type="jsonb"/>
            <column name="text_extraction_prompts" type="jsonb"/>
            <column name="expires_in" type="INT"/>
            <column name="expiry_period" type="VARCHAR(255)"/>
            <column name="expiry_field_fk" type="UUID"/>
        </createTable>

        <createTable tableName="expected_field">
            <column name="id" type="UUID"><constraints nullable="false" primaryKey="true" primaryKeyName="expected_field_pkey"/></column>
            <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="created_by" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="modified_at" type="TIMESTAMP"/>
            <column name="modified_by" type="VARCHAR(255)"/>
            <column name="field" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="mandatory" type="BOOLEAN"/>
            <column name="format" type="VARCHAR(255)"/>
            <column name="match_to" type="VARCHAR(255)"/>
            <column name="target_type" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="many" type="BOOLEAN"/>
            <column name="field_type" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="field_label" type="VARCHAR(255)"/>
            <column name="exact_match" type="BOOLEAN"/>
            <column name="data_processor_fk" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_expected_field_processor" referencedTableName="data_processor" referencedColumnNames="id"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="expected_field" columnNames="field, data_processor_fk" constraintName="expected_field_unique"/>
        <addForeignKeyConstraint baseTableName="data_processor" baseColumnNames="expiry_field_fk" constraintName="fk_data_processor_expiry_field"
                                 referencedTableName="expected_field" referencedColumnNames="id"/>

        <createTable tableName="verification_data_config">
            <column name="id" type="UUID"><constraints nullable="false" primaryKey="true" primaryKeyName="verification_data_config_pkey"/></column>
            <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="created_by" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="modified_at" type="TIMESTAMP"/>
            <column name="modified_by" type="VARCHAR(255)"/>
            <column name="name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="data_processor_fk" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_verification_config_processor" referencedTableName="data_processor" referencedColumnNames="id"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="verification_data_config" columnNames="name, data_processor_fk" constraintName="data_processor_data_unique"/>

        <createTable tableName="expected_fields2verification_data_configs">
            <column name="verification_data_configs_fk" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_fields2configs_config" referencedTableName="verification_data_config" referencedColumnNames="id"/>
            </column>
            <column name="expected_fields_fk" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_fields2configs_field" referencedTableName="expected_field" referencedColumnNames="id"/>
            </column>
        </createTable>

        <createTable tableName="data_field_group">
            <column name="id" type="UUID"><constraints nullable="false" primaryKey="true" primaryKeyName="data_field_group_pkey"/></column>
            <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="created_by" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="modified_at" type="TIMESTAMP"/>
            <column name="modified_by" type="VARCHAR(255)"/>
            <column name="label" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="description" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="target_type" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="position" type="INT"/>
        </createTable>

        <createTable tableName="data_field">
            <column name="id" type="UUID"><constraints nullable="false" primaryKey="true" primaryKeyName="data_field_pkey"/></column>
            <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="created_by" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="modified_at" type="TIMESTAMP"/>
            <column name="modified_by" type="VARCHAR(255)"/>
            <column name="position" type="INT"/>
            <column name="data_field_group_fk" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_data_field_group" referencedTableName="data_field_group" referencedColumnNames="id"/>
            </column>
            <column name="expected_field_fk" type="UUID">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_data_field_expected_field" foreignKeyName="fk_data_field_expected_field" referencedTableName="expected_field" referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Verification is knowvera-api's: the expected fields no longer name the client attribute they are
         matched to. The column and its old values stay, but new fields leave it empty. The tables of the
         removed verification configs and field groups (verification_data_config, data_field_group,
         data_field) are left in place, unused. -->
    <changeSet id="veritas-4-expected-field-target-type-optional" author="knowvera">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="expected_field" columnName="target_type"/>
        </preConditions>
        <dropNotNullConstraint tableName="expected_field" columnName="target_type" columnDataType="VARCHAR(255)"/>
    </changeSet>
</databaseChangeLog>
